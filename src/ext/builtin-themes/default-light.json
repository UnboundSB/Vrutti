{
  "name": "Vrutti Default Light",
  "type": "light",
  "colors": {
    "editor.background": "#ffffff",
    "sideBar.background": "#f3f3f3",
    "activityBar.background": "#f3f3f3",
    "editorGroupHeader.tabsBackground": "#f3f3f3",
    "editor.foreground": "#333333",
    "sideBarTitle.foreground": "#666666",
    "tab.activeBackground": "#e4e6f1",
    "button.background": "#007acc",
    "focusBorder": "#007acc",
    "editorLineNumber.foreground": "#999999",
    "terminal.background": "#ffffff",
    "gitDecoration.modifiedResourceForeground": "#007acc",
    "gitDecoration.untrackedResourceForeground": "#238636",
    "gitDecoration.deletedResourceForeground": "#d73a49"
  },
  "tokenColors": [
    { "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#6b7280", "fontStyle": "italic" } },
    { "scope": ["keyword", "storage.type", "storage.modifier", "keyword.control"], "settings": { "foreground": "#1d4ed8" } },
    { "scope": ["string", "punctuation.definition.string", "string.quoted"], "settings": { "foreground": "#15803d" } },
    { "scope": ["entity.name.function", "support.function", "meta.function-call"], "settings": { "foreground": "#c2410c" } },
    { "scope": ["constant.numeric", "constant.language", "constant.character"], "settings": { "foreground": "#7e22ce" } },
    { "scope": ["variable", "entity.name.variable", "variable.parameter", "variable.other"], "settings": { "foreground": "#374151" } },
    { "scope": ["entity.name.type", "entity.name.class", "support.class", "support.type"], "settings": { "foreground": "#be185d" } },
    { "scope": ["keyword.operator", "punctuation.separator", "punctuation.terminator"], "settings": { "foreground": "#000000" } },
    { "scope": ["entity.other.attribute-name", "meta.attribute"], "settings": { "foreground": "#6d28d9" } },
    { "scope": ["entity.name.tag", "meta.tag"], "settings": { "foreground": "#0369a1" } }
  ]
}
