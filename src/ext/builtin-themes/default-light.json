{
  "name": "Vrutti Default Light",
  "type": "light",
  "colors": {
    "editor.background": "#ffffff",
    "sideBar.background": "#f3f3f3",
    "activityBar.background": "#f3f3f3",
    "editorGroupHeader.tabsBackground": "#f3f3f3",
    "editor.foreground": "#333333",
    "sideBarTitle.foreground": "#666666",
    "tab.activeBackground": "#e4e6f1",
    "button.background": "#007acc",
    "focusBorder": "#007acc",
    "editorLineNumber.foreground": "#999999",
    "terminal.background": "#ffffff",
    "gitDecoration.modifiedResourceForeground": "#007acc",
    "gitDecoration.untrackedResourceForeground": "#238636",
    "gitDecoration.deletedResourceForeground": "#d73a49"
  },
  "tokenColors": [
    { "scope": ["keyword", "storage", "storage.type", "keyword.control"], "settings": { "foreground": "#0000FF" } },
    { "scope": ["string", "string.quoted"], "settings": { "foreground": "#A31515" } },
    { "scope": ["entity.name.function", "support.function"], "settings": { "foreground": "#795E26" } },
    { "scope": ["constant.numeric"], "settings": { "foreground": "#098658" } },
    { "scope": ["comment"], "settings": { "foreground": "#008000", "fontStyle": "italic" } },
    { "scope": ["variable", "entity.name.variable", "variable.parameter"], "settings": { "foreground": "#001080" } },
    { "scope": ["entity.name.type", "entity.name.class", "support.class"], "settings": { "foreground": "#267F99" } },
    { "scope": ["keyword.operator"], "settings": { "foreground": "#000000" } }
  ]
}
