{
    "id": "vrutti glass dark",
    "name": "vrutti-glass-dark",
    "type": "dark",
    "colors": {
        "--vrutti-glass-bg": "radial-gradient(circle at 10% 20%, rgba(245, 192, 191, 0.15) 0%, transparent 40%), radial-gradient(circle at 90% 80%, rgba(198, 180, 216, 0.15) 0%, transparent 40%), #0D1117",
        "--vrutti-bg": "rgba(0, 0, 0, 0.2)",
        "--vrutti-surface": "rgba(5, 5, 10, 0.4)",
        "--vrutti-surface-border": "rgba(255, 255, 255, 0.08)",
        "--vrutti-text": "#f8fafc",
        "--vrutti-text-bright": "#ffffff",
        "--vrutti-accent": "#0ea5e9",
        "--vrutti-tree-active": "rgba(14, 165, 233, 0.2)"
    },
    "tokenColors": [
        { "scope": ["keyword", "storage", "storage.type", "keyword.control"], "settings": { "foreground": "#C586C0" } },
        { "scope": ["string", "string.quoted"], "settings": { "foreground": "#CE9178" } },
        { "scope": ["entity.name.function", "support.function"], "settings": { "foreground": "#DCDCAA" } },
        { "scope": ["constant.numeric"], "settings": { "foreground": "#B5CEA8" } },
        { "scope": ["comment"], "settings": { "foreground": "#6A9955", "fontStyle": "italic" } },
        { "scope": ["variable", "entity.name.variable", "variable.parameter"], "settings": { "foreground": "#9CDCFE" } },
        { "scope": ["entity.name.type", "entity.name.class", "support.class"], "settings": { "foreground": "#4EC9B0" } },
        { "scope": ["keyword.operator"], "settings": { "foreground": "#D4D4D4" } }
    ]
}
